@model RegisterCooperativaViewModel
@{
    ViewData["Title"] = "Cadastrar cooperativa";
}
<section class="form-card wide-form">
    <span class="eyebrow">Nova conta</span>
    <h1>Cadastrar cooperativa</h1>
    <form asp-action="RegisterCooperativa" method="post">
        <div asp-validation-summary="ModelOnly" class="validation-errors"></div>
        <div class="form-grid">
            <label asp-for="Cnpj"></label><input asp-for="Cnpj" inputmode="numeric" autocomplete="off" /><span asp-validation-for="Cnpj"></span>
            <label asp-for="RazaoSocial"></label><input asp-for="RazaoSocial" autocomplete="organization" /><span asp-validation-for="RazaoSocial"></span>
            <label asp-for="Endereco"></label><input asp-for="Endereco" autocomplete="street-address" /><span asp-validation-for="Endereco"></span>
            <label asp-for="Cidade"></label><input asp-for="Cidade" autocomplete="address-level2" /><span asp-validation-for="Cidade"></span>
            <label asp-for="Estado"></label><input asp-for="Estado" maxlength="2" autocomplete="address-level1" /><span asp-validation-for="Estado"></span>
            <label asp-for="Email"></label><input asp-for="Email" autocomplete="email" /><span asp-validation-for="Email"></span>
            <label asp-for="Password"></label><input asp-for="Password" autocomplete="new-password" /><span asp-validation-for="Password"></span>
            <label asp-for="ConfirmPassword"></label><input asp-for="ConfirmPassword" autocomplete="new-password" /><span asp-validation-for="ConfirmPassword"></span>
        </div>
        <div class="form-actions"><a class="button button-secondary" asp-action="Login">Cancelar</a><button class="button" type="submit">Criar conta</button></div>
    </form>
</section>
