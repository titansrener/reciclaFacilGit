@model IReadOnlyList<CooperativaResumo>

@if (Model.Count == 0)
{
    <p class="empty-state">Nenhuma cooperativa encontrada com esses filtros.</p>
}
else
{
    <div class="results">
        @foreach (var cooperativa in Model)
        {
            <article>
                <h3>@cooperativa.Nome</h3>
                <p>@cooperativa.Endereco · @cooperativa.Cidade/@cooperativa.Estado</p>
            </article>
        }
    </div>
}
