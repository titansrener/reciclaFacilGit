@model ClienteDashboardViewModel
@{
    ViewData["Title"] = "Minhas coletas";
}
<div class="page-heading">
    <div><span class="eyebrow">Olá, @Model.Nome</span><h1>Minhas coletas</h1></div>
    <a class="button" asp-action="AgendarColeta">Agendar coleta</a>
</div>
@if (TempData["Sucesso"] is string sucesso) { <div class="success-message" role="status">@sucesso</div> }
@if (Model.Coletas.Count == 0)
{
    <div class="empty-state"><h2>Nenhuma coleta agendada</h2><p>Seus próximos agendamentos aparecerão aqui.</p></div>
}
else
{
    <div class="data-table">
        <table>
            <thead><tr><th>Data e horário</th><th>Situação</th><th>Materiais</th></tr></thead>
            <tbody>
            @foreach (var coleta in Model.Coletas)
            {
                <tr>
                    <td><a asp-action="DetalheColeta" asp-route-id="@coleta.Id">@(coleta.HorarioAgendado?.ToString("dd/MM/yyyy 'às' HH:mm") ?? "A definir")</a></td>
                    <td><span class="status status-@coleta.Status.ToLowerInvariant()">@StatusColeta(coleta.Status)</span></td>
                    <td>@coleta.QuantidadeMateriais @if (coleta.Status == "A") { <a class="danger-link row-action" asp-action="CancelarColeta" asp-route-id="@coleta.Id">Cancelar</a> }</td>
                </tr>
            }
            </tbody>
        </table>
    </div>
}
@functions {
    private static string StatusColeta(string status) => status switch
    {
        "A" => "Aguardando",
        "I" => "Em andamento",
        "F" => "Finalizada",
        _ => "Não informado"
    };
}
