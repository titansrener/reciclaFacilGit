@using Microsoft.AspNet.Identity
@using ReciclaFacil.Models

@if (Request.IsAuthenticated)
{
    using (Html.BeginForm("LogOff", "Account", FormMethod.Post, new { id = "logoutForm", @class = "account-actions" }))
    {
        @Html.AntiForgeryToken()
        var user = new UserInfo();
        @Html.ActionLink("Olá, " + user.getNome(User.Identity.GetUserId()), "Index", "Manage", null, new { @class = "account-link" })
        <button type="submit" class="link-button">Sair</button>
    }
}
else
{
    <div class="account-actions">
        @Html.ActionLink("Entrar", "Login", "Account", null, new { @class = "account-link" })
        <div class="dropdown">
            <button class="register-button dropdown-toggle" type="button" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                Criar conta <span class="caret"></span>
            </button>
            <ul class="dropdown-menu dropdown-menu-right">
                <li>@Html.ActionLink("Cliente", "RegisterCliente", "Account")</li>
                <li>@Html.ActionLink("Empresa", "RegisterEmpresa", "Account")</li>
                <li>@Html.ActionLink("Cooperativa", "RegisterCooperativa", "Account")</li>
            </ul>
        </div>
    </div>
}
