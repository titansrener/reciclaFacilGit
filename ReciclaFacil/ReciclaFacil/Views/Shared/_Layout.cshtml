@using Microsoft.AspNet.Identity
@using ReciclaFacil.Models
@{
    var userInfo = new UserInfo();
    var isAuthenticated = User.Identity.IsAuthenticated;
    var userId = isAuthenticated ? User.Identity.GetUserId() : null;
    var userRole = isAuthenticated ? userInfo.getRoles(userId) : String.Empty;
}
<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#176b45" />
    <title>@ViewBag.Title | Recicla Fácil</title>
    @Styles.Render("~/Content/css")
    @Scripts.Render("~/bundles/modernizr")
</head>
<body>
    <a class="skip-link" href="#conteudo-principal">Ir para o conteúdo</a>

    <div id="preloader" aria-hidden="true">
        <div id="status"></div>
    </div>

    <header class="app-header">
        <button class="menu-toggle" id="menu-toggle" type="button" aria-label="Abrir menu" aria-controls="app-menu" aria-expanded="false">
            <span></span><span></span><span></span>
        </button>
        @Html.ActionLink("Recicla Fácil", "Index", "Home", new { area = "" }, new { @class = "brand", aria_label = "Recicla Fácil — página inicial" })

        <div class="header-actions">
            @if (isAuthenticated && userRole == "Cliente")
            {
                <a class="notification-button" href="@Url.Action("Notificacoes", "Clientes")" aria-label="Ver notificações">
                    <span class="glyphicon glyphicon-bell" aria-hidden="true"></span>
                    <span id="notificacoesCount">@{ Html.RenderPartial(Url.Content("../Clientes/notificacoesCount"), 0); }</span>
                </a>
            }
            @Html.Partial("_LoginPartial")
        </div>
    </header>

    <aside class="app-sidebar" id="app-menu" aria-label="Navegação principal">
        <nav>
            @Html.ActionLink("Início", "Index", "Home", null, new { @class = "nav-link" })
            @if (isAuthenticated)
            {
                if (userRole == "Cliente")
                {
                    @Html.ActionLink("Coletas", "Index", "Clientes", null, new { @class = "nav-link" })
                    if (userInfo.getTipoCliente(userId) == "V")
                    {
                        @Html.ActionLink("Carteira", "Carteira", "Clientes", null, new { @class = "nav-link" })
                    }
                    @Html.ActionLink("Notificações", "Notificacoes", "Clientes", null, new { @class = "nav-link" })
                }
                else if (userRole == "Funcionario")
                {
                    @Html.ActionLink("Coletas", "Index", "Funcionarios", null, new { @class = "nav-link" })
                }
                else if (userRole == "Cooperativa")
                {
                    @Html.ActionLink("Coletas", "Index", "Cooperativas", null, new { @class = "nav-link" })
                    @Html.ActionLink("Funcionários", "Funcionarios", "Cooperativas", null, new { @class = "nav-link" })
                    @Html.ActionLink("Caminhões", "Caminhoes", "Cooperativas", null, new { @class = "nav-link" })
                    @Html.ActionLink("Materiais", "Materiais", "Cooperativas", null, new { @class = "nav-link" })
                }
                else if (userRole == "Admin")
                {
                    @Html.ActionLink("Materiais", "Materiais", "Administrador", null, new { @class = "nav-link" })
                }
                @Html.ActionLink("Minha conta", "Index", "Manage", null, new { @class = "nav-link" })
            }
            else
            {
                @Html.ActionLink("Entrar", "Login", "Account", null, new { @class = "nav-link" })
                @Html.ActionLink("Criar conta", "RegisterCliente", "Account", null, new { @class = "nav-link" })
            }
        </nav>
    </aside>
    <button class="sidebar-backdrop" id="sidebar-backdrop" type="button" aria-label="Fechar menu"></button>

    <main class="app-main" id="conteudo-principal" tabindex="-1">
        <div class="container body-content">
            @RenderBody()
        </div>
    </main>

    <footer class="app-footer">
        <div class="container">
            <span>&copy; @DateTime.Now.Year Recicla Fácil</span>
            <span>Reciclar aproxima pessoas e transforma cidades.</span>
        </div>
    </footer>

    @Scripts.Render("~/bundles/jquery")
    @Scripts.Render("~/bundles/bootstrap")
    @Scripts.Render("~/bundles/inputmask")
    @RenderSection("scripts", required: false)
    <script>
        (function ($) {
            var $body = $('body');
            var $toggle = $('#menu-toggle');

            function setMenu(open) {
                $body.toggleClass('menu-open', open);
                $toggle.attr('aria-expanded', open ? 'true' : 'false');
                $toggle.attr('aria-label', open ? 'Fechar menu' : 'Abrir menu');
            }

            $toggle.on('click', function () { setMenu(!$body.hasClass('menu-open')); });
            $('#sidebar-backdrop').on('click', function () { setMenu(false); });
            $(document).on('keyup', function (event) {
                if (event.keyCode === 27) setMenu(false);
            });
            $(window).on('load', function () {
                $('#status').fadeOut(150);
                $('#preloader').delay(100).fadeOut(200);
            });

            @if (isAuthenticated && userRole == "Cliente")
            {
                <text>
                function atualizarNotificacoes() {
                    $.get('@Url.Action("notificacoesCount", "Clientes")')
                        .done(function (data) { $('#notificacoesCount').html(data); });
                }
                window.setInterval(atualizarNotificacoes, 30000);
                </text>
            }
        })(jQuery);
    </script>
</body>
</html>
